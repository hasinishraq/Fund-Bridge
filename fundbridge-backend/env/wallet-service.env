SPRING_PROFILES_ACTIVE=dev
CONFIG_SERVER_URL=http://localhost:8899

# Service port override if needed
WALLET_SERVICE_PORT=8091

# Database (wallet_db schema)
WALLET_DB_URL=jdbc:mysql://localhost:3306/wallet_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
WALLET_DB_USERNAME=root
WALLET_DB_PASSWORD=12345678
WALLET_JPA_DDL_AUTO=update

# Wallet defaults
WALLET_DEFAULT_CURRENCY=BDT
WALLET_DEFAULT_USER_ID=1

# Object storage (for receipts/statements)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=wallet-data
STORAGE_BASE_PATH=/data/wallet
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_STATEMENTS_PATH=statements
STORAGE_RECEIPTS_PATH=receipts
